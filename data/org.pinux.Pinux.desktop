[Desktop Entry]
Name=Pinux
Comment=Aplikasi penerjemah desktop GTK4 untuk Linux
Exec=pinux
Icon=pinux
Terminal=false
Type=Application
Categories=Utility;Translation;TextTools;
StartupNotify=true
Actions=trigger;input;pick-region;ocr-copy;settings;

[Desktop Action trigger]
Name=Terjemahkan Clipboard
Exec=pinux --trigger

[Desktop Action input]
Name=Terjemah Input
Exec=pinux --input

[Desktop Action pick-region]
Name=Tangkapan Layar & OCR
Exec=pinux --pick-region

[Desktop Action ocr-copy]
Name=OCR Senyap (Salin Teks)
Exec=pinux --ocr-copy

[Desktop Action settings]
Name=Pengaturan
Exec=pinux --settings
